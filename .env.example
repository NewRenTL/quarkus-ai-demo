# ============================================================
# Variables de entorno requeridas — copia esto a .env y rellena
# NUNCA commitees el archivo .env con valores reales
# ============================================================

# --- Gemini AI (requerido para ai-service) ---
# Obtén tu API key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- Base de datos (solo en modo producción / docker compose) ---
# En dev mode Quarkus las arranca automáticamente via Dev Services
DB_USER=postgres
DB_PASSWORD=postgres

# --- Kafka (solo en modo producción) ---
# En dev mode Quarkus lo arranca automáticamente via Dev Services
KAFKA_BROKERS=localhost:9092

# --- URLs de base de datos por servicio ---
# Quarkus order-service (Docker: puerto 5434)
DB_URL=postgresql://localhost:5434/ordersdb

# Spring order-service (Docker: puerto 5435)
# DB_URL=jdbc:postgresql://localhost:5435/ordersdb_spring
